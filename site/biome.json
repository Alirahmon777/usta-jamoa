{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "root": true,
  "vcs": {
    "enabled": false,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!dist", "!node_modules"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120,
    "formatWithErrors": false,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "jsxQuoteStyle": "double",
      "trailingCommas": "none",
      "arrowParentheses": "always"
    },
    "parser": {
      "jsxEverywhere": false
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              [":NODE:", ":BUN:"],
              ["react", "react/**", "react-*"],
              "@tanstack/**",
              ":PACKAGE:",
              ":BLANK_LINE:",
              "@/app",
              ":BLANK_LINE:",
              "@/pages/**",
              ":BLANK_LINE:",
              "@/widgets/**",
              ":BLANK_LINE:",
              "@/features/**",
              ":BLANK_LINE:",
              "@/entities/**",
              ":BLANK_LINE:",
              "@/shared/**",
              ":BLANK_LINE:",
              ":PATH:"
            ]
          }
        }
      }
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": "error",
        "useExhaustiveDependencies": "off",
        "useUniqueElementIds": "error"
      },
      "performance": {
        "noReExportAll": "error"
      },
      "complexity": {
        "noUselessFragments": "error",
        "noBannedTypes": "error",
        "noForEach": "error",
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 12
          }
        }
      },
      "a11y": {
        "useKeyWithClickEvents": "off",
        "noSvgWithoutTitle": "off"
      },
      "style": {
        "noNonNullAssertion": "error",
        "noEnum": "error",
        "noExportedImports": "error",
        "noNamespace": "error",
        "noNestedTernary": "error",
        "useDefaultSwitchClause": "error",
        "useExportsLast": "error",
        "noDefaultExport": "error",
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "filenameCases": ["kebab-case"],
            "requireAscii": true
          }
        },
        "useNumericSeparators": "error",
        "useReactFunctionComponents": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["@/*/*/*", "@/*/*/**"],
                "message": "Import a slice or segment through its public API (index.ts), not its internal files."
              }
            ]
          }
        }
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noAlert": "error",
        "noVar": "error",
        "useAwait": "error",
        "noEmptyInterface": "error",
        "noConsole": "error"
      }
    }
  },
  "css": {
    "formatter": {
      "enabled": false
    },
    "linter": {
      "enabled": false
    }
  },
  "overrides": [
    {
      "includes": ["**/src/shared/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/*/*/*", "@/*/*/**"],
                    "message": "Import a slice or segment through its public API (index.ts), not its internal files."
                  },
                  {
                    "group": [
                      "@/app",
                      "@/app/**",
                      "@/pages",
                      "@/pages/**",
                      "@/widgets",
                      "@/widgets/**",
                      "@/features",
                      "@/features/**",
                      "@/entities",
                      "@/entities/**"
                    ],
                    "message": "shared imports only from shared and @repo/* packages."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/src/entities/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/*/*/*", "@/*/*/**"],
                    "message": "Import a slice or segment through its public API (index.ts), not its internal files."
                  },
                  {
                    "group": [
                      "@/app",
                      "@/app/**",
                      "@/pages",
                      "@/pages/**",
                      "@/widgets",
                      "@/widgets/**",
                      "@/features",
                      "@/features/**",
                      "@/entities",
                      "@/entities/**"
                    ],
                    "message": "entities import only from shared; no cross-slice imports."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/src/features/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/*/*/*", "@/*/*/**"],
                    "message": "Import a slice or segment through its public API (index.ts), not its internal files."
                  },
                  {
                    "group": [
                      "@/app",
                      "@/app/**",
                      "@/pages",
                      "@/pages/**",
                      "@/widgets",
                      "@/widgets/**",
                      "@/features",
                      "@/features/**"
                    ],
                    "message": "features import only from entities and shared; no cross-slice imports."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/src/widgets/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/*/*/*", "@/*/*/**"],
                    "message": "Import a slice or segment through its public API (index.ts), not its internal files."
                  },
                  {
                    "group": ["@/app", "@/app/**", "@/pages", "@/pages/**", "@/widgets", "@/widgets/**"],
                    "message": "widgets import only from features, entities and shared."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/src/pages/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/*/*/*", "@/*/*/**"],
                    "message": "Import a slice or segment through its public API (index.ts), not its internal files."
                  },
                  {
                    "group": ["@/app", "@/app/**", "@/pages", "@/pages/**"],
                    "message": "pages import only from widgets, features, entities and shared."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/*.config.{ts,mts,js,mjs}", "**/*.d.ts"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    }
  ]
}
